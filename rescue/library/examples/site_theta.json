  "actions": [
    {
      "id": "stow_away",
      "ability": "liquid",
      "bind": [],
      "where": [],
      "pre": [
        "monster.loc == loading_dock",
        "truck_arrived == true",
        "monster.form == liquid"
      ],
      "eff": [
        "monster.loc = outside"
      ],
      "text": "Seep into a crate on the supply truck and ride out through the perimeter gate."
    }
  ],
  "rules": [
    {
      "id": "supply_truck",
      "bind": [],
      "where": [],
      "when": [
        "turn >= 18",
        "truck_arrived == false"
      ],
      "then": [
        "truck_arrived = true"
      ],
      "text": "A supply truck backs into the loading dock."
    },
    {
      "id": "screams",
      "bind": [],
      "where": [],
      "when": [
        "monster.form == self",
        "here.witnesses >= 1",
        "monster.loc != cell"
      ],
      "then": [
        "alarm += 1"
      ],
      "text": "A witness screams and hits the panic button."
    }
  ],
  "losses": [
    {
      "id": "incinerated",
      "when": [
        "monster.loc == cell",
        "lockdown >= 1"
      ],
      "text": "The cell incinerator cycles while you are still inside."
    }
  ],
