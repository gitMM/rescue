  "actions": [
    {
      "id": "crawl",
      "ability": "liquid",
      "bind": [
        {
          "name": "p",
          "from": "passages"
        }
      ],
      "where": [
        "{p.kind} == vent"
      ],
      "pre": [
        "monster.loc == {p.from}",
        "monster.form == liquid",
        "vent.{p.via}.sealed == false"
      ],
      "eff": [
        {
          "if": [
            "air_scrubbed == false"
          ],
          "then": [
            "toxin += 1"
          ],
          "else": []
        },
        "monster.loc = {p.to}"
      ],
      "text": "Ooze through {p.via_name} from {p.from_name} to {p.to_name}."
    },
    {
      "id": "scrub_air",
      "ability": "hack",
      "bind": [],
      "where": [],
      "pre": [
        "monster.loc == hvac",
        "monster.form != liquid",
        "term.term_hvac.hacked == true",
        "air_scrubbed == false"
      ],
      "eff": [
        "air_scrubbed = true"
      ],
      "text": "Switch the air handlers to full filtration and flush the nerve agent out of the ducts."
    }
  ],
  "rules": [
    {
      "id": "elevator_lockout",
      "bind": [],
      "where": [],
      "when": [
        "alarm >= 3",
        "door.d_street.locked == false"
      ],
      "then": [
        "door.d_street.locked = true"
      ],
      "text": "Security locks the express elevator out between floors."
    }
  ],
  "losses": [
    {
      "id": "poisoned",
      "when": [
        "toxin >= 2"
      ],
      "text": "The nerve agent soaks into every cell; you come apart inside the ductwork."
    }
  ],
